rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /notes/{token} {

      // ── Read Single Document (preview, share page /p/[slug], slug availability) ──
      allow get: if true;

      // ── List / Query Documents (dashboard notes list by creator_uid) ───────────
      allow list: if request.query.filters.size() == 1
                  && request.query.filters[0].fieldPath == 'creator_uid'
                  && request.query.filters[0].value is string
                  && request.query.filters[0].value.size() > 0;

      // ── Create Note (unauthenticated guest device-ID or auth UID) ───────────────
      allow create: if request.resource.data.keys().hasAll([
                        'creator_uid', 'recipient_name', 'custom_message',
                        'image_urls', 'is_paid', 'template', 'created_at'
                      ])
                    && request.resource.data.creator_uid is string
                    && request.resource.data.creator_uid.size() > 0
                    && request.resource.data.recipient_name is string
                    && request.resource.data.is_paid == false;

      // ── Update Note ───────────────────────────────────────────────────────────
      allow update: if (request.auth != null && resource.data.creator_uid == request.auth.uid)
                    || (resource.data.creator_uid is string && resource.data.creator_uid == request.resource.data.creator_uid);

      // ── Delete Note ───────────────────────────────────────────────────────────
      allow delete: if (request.auth != null && resource.data.creator_uid == request.auth.uid);
    }

  }
}
